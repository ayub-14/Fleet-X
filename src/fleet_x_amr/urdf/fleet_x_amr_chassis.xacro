<?xml version="1.0"?>
<!--
  FLEET-X : chassis links.

  base_footprint -> base_link is a fixed joint and carries no inertia. This
  keeps the rotation centre (the point the odometry actually integrates about)
  on the ground, which is what Nav2 and the later localiser phases expect.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Ground-projected frame. Purely kinematic reference; it has no mass and no
    collision geometry so it never perturbs the Gazebo physics.
  -->
  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="fleet_x_chassis_grey"/>
    </visual>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${BASE_LINK_HEIGHT}" rpy="0 0 0"/>
  </joint>

  <!--
    Main chassis body. The inertia tensor is the analytic box tensor,
    evaluated from the dimensions declared in fleet_x_amr_dimensions.xacro so
    that changing a dimension automatically yields a consistent tensor.
  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${BASE_LENGTH} ${BASE_WIDTH} ${BASE_HEIGHT}"/>
      </geometry>
      <material name="fleet_x_chassis_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${BASE_LENGTH} ${BASE_WIDTH} ${BASE_HEIGHT}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${BASE_MASS}"/>
      <inertia
        ixx="${BASE_MASS * (BASE_WIDTH * BASE_WIDTH + BASE_HEIGHT * BASE_HEIGHT) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${BASE_MASS * (BASE_LENGTH * BASE_LENGTH + BASE_HEIGHT * BASE_HEIGHT) / 12.0}"
        iyz="0.0"
        izz="${BASE_MASS * (BASE_LENGTH * BASE_LENGTH + BASE_WIDTH * BASE_WIDTH) / 12.0}"/>
    </inertial>
  </link>

  <!--
    A low-profile sensor mast stub. It carries no sensor in Phase 2A; it exists
    only so that later sensing phases have a defined mounting frame
    ("sensor_mount") and do not have to redesign the chassis.
  -->
  <joint name="base_link_to_sensor_mount" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mount"/>
    <origin xyz="${BASE_LENGTH / 2.0 - 0.02} 0 ${BASE_HEIGHT / 2.0}"
            rpy="0 0 0"/>
  </joint>

  <link name="sensor_mount">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="fleet_x_chassis_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0"
               iyy="1.0e-05" iyz="0.0" izz="1.0e-05"/>
    </inertial>
  </link>

</robot>