<?xml version="1.0"?>
<!--
  FLEET-X : Gazebo material definitions.

  Declared once and referenced by name from the visual blocks so that the
  chassis and the wheels keep a consistent, easily re-themeable palette.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="fleet_x_chassis_grey">
    <color rgba="0.30 0.32 0.35 1.0"/>
  </material>

  <material name="fleet_x_chassis_accent">
    <color rgba="0.10 0.45 0.70 1.0"/>
  </material>

  <material name="fleet_x_wheel_dark">
    <color rgba="0.12 0.12 0.13 1.0"/>
  </material>

  <material name="fleet_x_wheel_hub">
    <color rgba="0.70 0.70 0.72 1.0"/>
  </material>

</robot>