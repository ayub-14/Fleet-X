<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_x_amr</name>
  <version>0.2.0</version>
  <description>
    FLEET-X cooperative warehouse AMR: own URDF/Xacro differential-drive
    description, Gazebo Harmonic world and a ros2_control drive chain
    (joint_state_broadcaster + diff_drive_controller) driven by the
    gz_ros2_control Gazebo system plugin.
  </description>
  <maintainer email="fleetx@example.com">FLEET-X</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build-time only: needed to render the Xacro description. -->
  <exec_depend>xacro</exec_depend>

  <!-- Robot description and TF. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- ros2_control drive chain. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>

  <!-- Gazebo Harmonic integration: server/GUI plus the ros2_control
       Gazebo system plugin that instantiates the controller manager. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- Visualisation. -->
  <exec_depend>rviz2</exec_depend>

  <!-- SLAM and localization. -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>