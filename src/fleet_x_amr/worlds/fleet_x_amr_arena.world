<?xml version="1.0"?>
<!--
  FLEET-X : Phase 2A simulation world.

  A deliberately plain, flat test arena. It contains only what is needed to
  verify ros2_control against real Gazebo physics:

    * a large flat floor whose top surface sits exactly at z = 0, matching the
      assumption baked into the AMR geometry (wheel axle one wheel radius above
      the floor);
    * a set of static storage racks, which give a fixed visual reference so
      that forward travel and rotation can be judged by eye in the GUI;
    * one light so the scene is visible.

  Phase 2A deliberately contains no sensors, no Nav2 configuration and no
  warehouse clutter models. Those belong to later phases.
-->
<sdf version="1.11">
  <world name="fleet_x_amr_arena">

    <!--
      Physics uses the default gz-sim engine (DART). The 'type' attribute is
      required by SDF, but it must name a real engine: with a bogus value such
      as "ignored" gz-sim rejects the whole <physics> element and silently
      falls back to its own defaults.
    -->
    <physics name="fleet_x_physics" type="default">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.62 0.66 0.72 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <!--
Floor. Modelled as a thin static box rather than an infinite plane so the
    contact surface is finite, well conditioned and cheap.

    The box is 0.1 m thick and its pose is offset by half that thickness, so
    the TOP face sits exactly at z = 0 as the header states. Without the
    offset a box is centred on its own pose, which would silently put the
    walking surface at z = +0.05 and leave every wheel hanging 50 mm above it.
    -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 40 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>1e3</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.55 0.57 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Static storage racks. Purely visual + collision reference geometry; placed
      far enough from the spawn point that the AMR cannot touch them during the
      Phase 2A manoeuvre tests.
    -->
    <model name="rack_north">
      <static>true</static>
      <pose>0 6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.6 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.6 2.2</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.20 1</ambient>
            <diffuse>0.70 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_south">
      <static>true</static>
      <pose>0 -6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.6 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.6 2.2</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.20 1</ambient>
            <diffuse>0.70 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_east">
      <static>true</static>
      <pose>6 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 6.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 6.0 2.2</size></box></geometry>
          <material>
            <ambient>0.20 0.40 0.55 1</ambient>
            <diffuse>0.25 0.50 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_a">
      <static>true</static>
      <pose>3.0 3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.50 0.50 0.52 1</ambient>
            <diffuse>0.62 0.62 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_b">
      <static>true</static>
      <pose>-3.0 -3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.50 0.50 0.52 1</ambient>
            <diffuse>0.62 0.62 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>